ASHARE_ENVIRONMENT=development
ASHARE_DATABASE_URL=sqlite:///./data/a_share_selection_lab.db
ASHARE_DATA_ROOT=./data
ASHARE_ARTIFACT_ROOT=./data/artifacts
ASHARE_TIMEZONE=Asia/Shanghai
ASHARE_CORS_ORIGINS=["http://localhost:5173"]
ASHARE_SCHEDULER_ENABLED=false
ASHARE_DAILY_FACTOR_ANALYSIS_ENABLED=true
ASHARE_WEEKLY_PARAMETER_RESEARCH_ENABLED=false
ASHARE_WEEKLY_STRATEGY_VALIDATION_ENABLED=false
ASHARE_MONTHLY_QLIB_EXPERIMENT_ENABLED=false
# Optional JSON request payloads for scheduled jobs:
# ASHARE_DAILY_FACTOR_ANALYSIS_CONFIG=./config/examples/daily-factor-analysis.json
# ASHARE_WEEKLY_PARAMETER_RESEARCH_CONFIG=./config/examples/weekly-vectorbt.json
# ASHARE_WEEKLY_STRATEGY_VALIDATION_CONFIG=./config/examples/weekly-rqalpha.json
# ASHARE_MONTHLY_QLIB_EXPERIMENT_CONFIG=./config/examples/monthly-qlib.json
ASHARE_MIN_DAILY_COVERAGE_RATIO=0.95
ASHARE_MIN_MINUTE_COVERAGE_RATIO=0.0
ASHARE_EXPECTED_UNIVERSE_SIZE=0
ASHARE_DEFAULT_BENCHMARK_SYMBOL=000300.SH
ASHARE_FREESTOCKDB_ENABLED=true
ASHARE_FREESTOCKDB_BASE_URL=http://127.0.0.1:7899
ASHARE_FREESTOCKDB_CONNECT_TIMEOUT_SECONDS=2
ASHARE_FREESTOCKDB_READ_TIMEOUT_SECONDS=60
ASHARE_FREESTOCKDB_MAX_CONCURRENCY=8
ASHARE_FREESTOCKDB_DEFAULT_LOOKBACK_DAYS=400
ASHARE_FREESTOCKDB_MINUTE_LOOKBACK_DAYS=45

# Purchased-data supplement is intentionally outside the ASHARE_* settings.
# Set these only in the invoking PowerShell session; never commit the token.
# TINYSHARE_TOKEN=<session-only credential>
# TINYSHARE_PYTHON=data/runtime/tinyshare-venv/Scripts/python.exe
